datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum ChannelType {
  EVOLUTION
  META_CLOUD
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

enum ConversationStatus {
  UNATTENDED
  OPEN
  CLOSED
}

enum ConversationQueue {
  RECEPTION
  DEPARTMENT
  CONVERSATION
  CLOSED
}

enum ConversationEventType {
  CLAIMED
  TRANSFERRED
  CLOSED
  REOPENED
}

enum MessageContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  SYSTEM
  NOTE
}

enum HelpArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Workspace {
  id                      String                  @id @default(uuid())
  name                    String
  locale                  String                  @default("pt_BR")
  supportEmail            String?
  active                  Boolean                 @default(true)
  blocked                 Boolean                 @default(false)
  plan                    String                  @default("ENTERPRISE")
  maxUsers                Int                     @default(20)
  maxChannels             Int                     @default(10)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  users                   User[]
  channels                Channel[]
  contacts                Contact[]
  conversations           Conversation[]
  departments             Department[]
  cannedResponses         CannedResponse[]
  helpCategories          HelpCategory[]
  helpArticles            HelpArticle[]
  labels                  Label[]
  savedExecutiveSummaries SavedExecutiveSummary[]
  conversationEvents      ConversationEvent[]
  conversationResolutions ConversationResolution[]
}

model SavedExecutiveSummary {
  id                String    @id @default(uuid())
  title             String
  summary           String
  days              Int       @default(7)
  businessHoursOnly Boolean   @default(false)
  createdByName     String?
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  role          String         @default("AGENT") // ADMIN ou AGENT (Atendente)
  avatarUrl     String?
  isOnline      Boolean        @default(true)
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  departments   Department[]
  helpArticles  HelpArticle[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Channel {
  id               String           @id @default(uuid())
  name             String
  type             ChannelType      @default(EVOLUTION)
  connectionStatus ConnectionStatus @default(DISCONNECTED)
  active           Boolean          @default(true)
  deletedAt        DateTime?
  workspaceId      String
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // WhatsApp Meta Cloud API
  metaToken         String?
  metaPhoneNumberId String?
  metaWabaId        String?

  // WhatsApp Evolution API (Go)
  evolutionInstanceName String?
  evolutionApiKey       String?
  qrCodeBase64          String? @db.Text

  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Contact {
  id            String         @id @default(uuid())
  name          String
  phone         String?
  email         String?
  avatarUrl     String?
  company       String?
  biography     String?
  location      String?
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  resolutions   ConversationResolution[]
  labels        Label[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workspaceId, phone])
}

model Conversation {
  id                    String             @id @default(uuid())
  idNumber              String             @default("")
  channelId             String
  channel               Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contactId             String
  contact               Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status                ConversationStatus @default(UNATTENDED)
  queue                 ConversationQueue  @default(RECEPTION)
  priority              String             @default("")
  assignedTeam          String             @default("")
  slaTimer              String             @default("")
  unreadCount           Int                @default(0)
  workspaceId           String
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId               String?
  agent                 User?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  departmentId          String?
  department            Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages              Message[]
  activityLogs          ActivityLog[]
  events                ConversationEvent[]
  resolutions           ConversationResolution[]
  closedAt              DateTime?
  closureReason         String?
  aiSummary             String?            @db.Text
  lastCustomerMessageAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([workspaceId, queue, updatedAt])
  @@index([workspaceId, closedAt])
  @@index([workspaceId, agentId])
  @@index([workspaceId, departmentId])
}

model Message {
  id             String             @id @default(uuid())
  externalId     String?
  conversationId String
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String             @db.Text
  contentType    MessageContentType @default(TEXT)
  senderType     MessageSenderType  @default(AGENT)
  senderName     String
  avatarPill     String?            @default("GT")
  mediaUrl       String?
  isPrivate      Boolean            @default(false)
  createdAt      DateTime           @default(now())
}

model ActivityLog {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userName       String
  action         String       @db.Text
  createdAt      DateTime     @default(now())
}

// Histórico estruturado das mudanças de fila. Ele é a fonte de auditoria
// para o atendimento e evita depender de textos livres em ActivityLog.
model ConversationEvent {
  id               String                @id @default(uuid())
  type             ConversationEventType
  conversationId   String
  conversation     Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId          String?
  actorName        String?
  fromQueue        ConversationQueue?
  toQueue          ConversationQueue?
  fromAgentId      String?
  toAgentId        String?
  fromDepartmentId String?
  toDepartmentId   String?
  metadata         Json?
  createdAt        DateTime              @default(now())

  @@index([workspaceId, createdAt])
  @@index([conversationId, createdAt])
}

// Snapshot imutável de cada encerramento. Uma conversa pode ser reaberta e
// encerrada novamente sem perder o atendimento finalizado anterior.
model ConversationResolution {
  id                   String       @id @default(uuid())
  conversationId       String
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspaceId          String
  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId            String
  contactId            String
  contact              Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  departmentId         String?
  departmentName       String?
  assignedAgentId      String?
  assignedAgentName    String?
  closedById           String
  closedByName         String
  reason               String
  openedAt             DateTime
  firstAgentResponseAt DateTime?
  closedAt             DateTime
  createdAt            DateTime     @default(now())

  @@index([workspaceId, closedAt])
  @@index([workspaceId, departmentId, closedAt])
  @@index([workspaceId, assignedAgentId, closedAt])
}

model Department {
  id              String         @id @default(uuid())
  name            String
  description     String?
  allowAutoAssign Boolean        @default(true)
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  users           User[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model CannedResponse {
  id          String    @id @default(uuid())
  shortcut    String
  content     String    @db.Text
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, shortcut])
}

model HelpCategory {
  id          String        @id @default(uuid())
  name        String
  slug        String
  description String?
  icon        String?
  iconColor   String?
  position    Int           @default(0)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles    HelpArticle[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, slug])
}

model HelpArticle {
  id          String            @id @default(uuid())
  title       String
  subject     String
  content     String            @db.Text
  status      HelpArticleStatus @default(PUBLISHED)
  position    Int               @default(0)
  attachments Json?
  fileUrl     String?
  fileName    String?
  videoUrl    String?
  views       Int               @default(0)
  categoryId  String?
  category    HelpCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId    String?
  author      User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Label {
  id            String    @id @default(uuid())
  name          String
  color         String    @default("#0091ff")
  description   String?
  showOnSidebar Boolean   @default(true)
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([workspaceId, name])
}
